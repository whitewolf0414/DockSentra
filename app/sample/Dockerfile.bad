# ── Dockerfile.bad ───────────────────────────────────────────────────────────
# This Dockerfile is deliberately insecure and designed to FAIL all 5 rules:
#
#   ✗ no_root_user          — no USER instruction (runs as root)
#   ✗ unpinned_base_image   — uses :latest tag
#   ✗ hardcoded_secret      — ENV contains a hard-coded API key / password
#   ✗ missing_healthcheck   — no HEALTHCHECK instruction
#   ✗ add_instead_of_copy   — uses ADD instead of COPY
#
# DO NOT use this Dockerfile in production.
# It exists solely as a test fixture for the security scanner.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:latest

WORKDIR /app

# Secrets hard-coded in ENV — triggers hardcoded_secret rule
ENV API_KEY=super_secret_api_key_12345
ENV DB_PASSWORD=admin123
ENV SECRET_TOKEN=do_not_commit_me

# Uses ADD instead of COPY — triggers add_instead_of_copy rule
ADD requirements.txt /app/requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

ADD . /app

# No USER instruction — triggers no_root_user rule
# No HEALTHCHECK instruction — triggers missing_healthcheck rule

EXPOSE 5000
CMD ["python", "-m", "app.web.app"]
